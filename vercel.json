{
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "wake": {
      "root": "wake",
      "entrypoint": "server.mjs",
      "functions": { "server.mjs": { "maxDuration": 120 } }
    }
  },
  "rewrites": [
    { "source": "/api/wake", "destination": { "service": "wake" } },
    { "source": "/api/(.*)", "destination": "https://trading-backend-wruf.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
